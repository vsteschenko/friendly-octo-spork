+        }
+      }
+
+/*
+ * Additional styles for the enhanced report page.  These summary cards give
+ * users a quick overview of their finances.  They follow the same border
+ * radius and color scheme as other elements on the page to ensure a
+ * cohesive look and feel.
+ */
+.summary-cards {
+    display: flex;
+    flex-direction: column;
+    gap: 10px;
+    width: 100%;
+    margin-bottom: 10px;
+}
+
+.summary-card {
+    border: 1px solid rgb(235, 233, 233);
+    border-radius: 15px;
+    padding: 10px;
+    display: flex;
+    flex-direction: column;
+}
+
+.summary-label {
+    font-size: 14px;
+    color: rgb(100, 100, 100);
+}
+
+.summary-value {
+    font-size: 20px;
+    font-weight: 700;
+    margin-top: 5px;
+}
+
+@media (min-width: 768px) {
+    .summary-cards {
+        flex-direction: row;
+        max-width: 600px;
+    }
+    .summary-card {
+        flex: 1;
+    }
+}
